rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Public MCQ Bank: candidates and visitors read MCQs across devices
    match /mcqs/{mcqId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Categories: Exam categories list
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Site Settings: Title, announcement, ads configuration
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Certificate verification & payments
    match /certificate_payments/{paymentId} {
      allow read, write: if true;
    }

    // Blog articles & guides
    match /blogPosts/{postId} {
      allow read, write: if true;
    }
  }
}
