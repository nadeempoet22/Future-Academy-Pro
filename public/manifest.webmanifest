{
  "id": "/",
  "name": "Future Academy Pro - MCQs & Exam Prep",
  "short_name": "FutureAcad",
  "description": "Pakistan's premier platform for solved MCQs, mock tests, and exam preparation with real-time sync.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#040d12",
  "theme_color": "#059669",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "education",
    "books",
    "reference",
    "productivity"
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.futureacademypro.app",
      "id": "com.futureacademypro.app"
    },
    {
      "platform": "webapp",
      "url": "https://futureacademypro.vercel.app/manifest.webmanifest"
    }
  ],
  "iarc_rating_id": "944a9cfb-81d3-463e-b8d9-a29285093e0b",
  "scope_extensions": [
    {
      "origin": "https://futureacademypro.vercel.app"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "navigate-new"
    ]
  },
  "file_handlers": [
    {
      "action": "/?import=file",
      "name": "MCQ Question Sheet",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ],
      "accept": {
        "text/plain": [
          ".txt",
          ".mcq"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+mcq",
      "url": "/?query=%s"
    }
  ],
  "share_target": {
    "action": "/?shared=true",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "note_taking": {
    "new_note_url": "/?action=notes"
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "widgets": [
    {
      "name": "Daily MCQ Quiz Widget",
      "short_name": "Daily Quiz",
      "description": "Quick daily exam prep question of the day widget",
      "tag": "daily-mcq-widget",
      "template": "widget-daily-quiz",
      "ms_ac_template": "widget.json",
      "data": "/api/mcqs?limit=1",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshots/mobile-1.png",
          "sizes": "750x1334",
          "label": "Daily MCQ Practice Widget"
        }
      ],
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Future Academy Pro Desktop Exam Dashboard"
    },
    {
      "src": "/screenshots/mobile-1.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Future Academy Pro Mobile Practice Quiz"
    }
  ],
  "shortcuts": [
    {
      "name": "Daily Practice Quiz",
      "short_name": "Daily Quiz",
      "description": "Start FPSC & PPSC daily practice test with instant scoring",
      "url": "/?quiz=daily",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Solved MCQs Bank",
      "short_name": "MCQs",
      "description": "Explore 50,000+ categorized solved MCQs",
      "url": "/?tab=home",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Exam Preparation Blog",
      "short_name": "Exam Blog",
      "description": "Read latest FPSC, PPSC and CSS preparation tips",
      "url": "/?tab=blog",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
